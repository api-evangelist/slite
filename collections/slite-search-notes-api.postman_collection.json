        {
          "id": "184cf5de-6488-4533-b570-6f125ba34748",
          "name": "Search notes",
          "request": {
            "name": "Search notes",
            "description": {
              "content": "Search notes based on a query.\nThe scope of the notes is restricted to the authenticated user.\nVarious optional filters are available to restrict the scope of the search even more.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "search-notes"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "query",
                  "value": "<string>",
                  "description": "Query used to perform the note search, default to empty string"
                },
                {
                  "disabled": false,
                  "key": "parentNoteId",
                  "value": "<string>",
                  "description": "Optional filter to only return notes under this parent note id"
                },
                {
                  "disabled": false,
                  "key": "depth",
                  "value": "<double>",
                  "description": "Optional filter to only return notes with a depth (number of parents) equal to a specified value"
                },
                {
                  "disabled": false,
                  "key": "reviewState",
                  "value": "<string>",
                  "description": "Optional filter to return notes in a special review state\nCan be Verified, Outdated, VerificationRequested or VerificationExpired"
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "<integer>",
                  "description": "Used to perform pagination on search"
                },
                {
                  "disabled": false,
                  "key": "hitsPerPage",
                  "value": "<integer>",
                  "description": "Specify how many notes to return per page"
                },
                {
                  "disabled": false,
                  "key": "highlightPreTag",
                  "value": "<string>",
                  "description": "Inject a tag before the matching query"
                },
                {
                  "disabled": false,
                  "key": "highlightPostTag",
                  "value": "<string>",
                  "description": "Inject a tag after the matching query"
                },
                {
                  "disabled": false,
                  "key": "includeArchived",
                  "value": "<boolean>",
                  "description": "Optional filter to also include archived notes in the search results (default to false)"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
